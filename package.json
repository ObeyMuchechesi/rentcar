{
  "name": "car-rental-system",
  "version": "1.0.0",
  "private": true,
  "description": "Car rental platform: customer booking site plus manager back-office (Express + MongoDB + React).",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "seed": "npm --prefix backend run seed",
    "migrate:global": "npm --prefix backend run globalise",
    "smoke": "npm --prefix backend run smoke",
    "concurrency": "npm --prefix backend run concurrency"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0"
  }
}
