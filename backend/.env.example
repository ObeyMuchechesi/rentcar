NODE_ENV=development
PORT=4000
# 'memory' runs an in-process MongoDB (no local server needed, data resets on exit).
# In production this must be a real MongoDB/Atlas connection string.
MONGODB_URI=memory
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Populate an empty database with the demo fleet on boot (ignored once data exists).
SEED_ON_START=true
SEED_MANAGER_EMAIL=manager@rental.test
SEED_MANAGER_PASSWORD=Manager123!
SEED_CUSTOMER_EMAIL=driver@rental.test
SEED_CUSTOMER_PASSWORD=Driver123!
